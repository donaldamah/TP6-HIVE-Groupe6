# ============================================================================
# Configuration Hadoop et Hive du cluster TP6 (Groupe 6)
# Les images bde2020 traduisent chaque variable en entree XML :
#   CORE_CONF_x_y     -> core-site.xml,  propriete x.y
#   HDFS_CONF_x_y     -> hdfs-site.xml
#   HIVE_SITE_CONF_x  -> hive-site.xml
# Un triple souligne ___ represente un tiret dans le nom de la propriete.
# ============================================================================

CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
CORE_CONF_hadoop_proxyuser_hue_hosts=*
CORE_CONF_hadoop_proxyuser_hue_groups=*
CORE_CONF_io_compression_codecs=org.apache.hadoop.io.compress.SnappyCodec,org.apache.hadoop.io.compress.GzipCodec

HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
# Un seul DataNode : la replication doit valoir 1, sinon le NameNode signale
# en permanence des blocs sous-repliques.
HDFS_CONF_dfs_replication=1
# Taille de bloc explicite (128 Mo) : c'est la valeur utilisee dans le calcul
# du nombre de blocs attendu par le Groupe 2 (Nblocs = plafond(F / B)).
HDFS_CONF_dfs_blocksize=134217728
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

HIVE_SITE_CONF_javax_jdo_option_ConnectionURL=jdbc:postgresql://hive-metastore-postgresql/metastore
HIVE_SITE_CONF_javax_jdo_option_ConnectionDriverName=org.postgresql.Driver
HIVE_SITE_CONF_javax_jdo_option_ConnectionUserName=hive
HIVE_SITE_CONF_javax_jdo_option_ConnectionPassword=hive
HIVE_SITE_CONF_datanucleus_autoCreateSchema=false
HIVE_SITE_CONF_hive_metastore_uris=thrift://hive-metastore:9083
HIVE_SITE_CONF_hive_metastore_warehouse_dir=/user/hive/warehouse

# HiveServer2 sans SASL : evite d'installer le module Python 'sasl', qui exige
# un compilateur C++ sous Windows. PyHive se connecte alors en transport brut.
HIVE_SITE_CONF_hive_server2_authentication=NOSASL

# Statistiques automatiques : DESCRIBE FORMATTED renvoie numRows et totalSize,
# utilises pour comparer la taille TEXTFILE et la taille ORC.
HIVE_SITE_CONF_hive_stats_autogather=true
